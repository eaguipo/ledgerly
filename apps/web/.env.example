# Supabase credentials — copy this file to `.env.local` and fill in real values.
# Find them in your Supabase project: Settings -> API.
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored. `.env.example` (this file) is committed as a template
# and must NEVER contain real keys.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" key. Safe to expose to the browser — Row Level Security is the
# real security boundary.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret "service_role" key. SERVER-ONLY. It BYPASSES Row Level Security, so it
# must NEVER be prefixed with NEXT_PUBLIC_ and must NEVER reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Logging (optional) ──────────────────────────────────────────────────────
# Read by the web app AND both microservices; same values everywhere.
#
# LOG_LEVEL   trace|debug|info|warn|error|fatal
#             Default: info in production, debug elsewhere.
# LOG_FORMAT  pretty|json  (web app only)
#             Default: pretty in development, json in production. Set to json
#             locally if you want to pipe `next dev` output through jq.
#LOG_LEVEL=debug
#LOG_FORMAT=pretty
